# Copy to .env and fill in on site; never commit .env.
ANTHROPIC_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Optional: any OpenAI-compatible URL for the student instead of Runpod serverless
STUDENT_BASE_URL=
# Optional: Runpod serverless price per worker-second for cost per decision
RUNPOD_PRICE_PER_SEC=0.00019
# SEC asks for a contact in the User-Agent, e.g. "Jane Doe jane@example.com"
SEC_USER_AGENT=
